node_modules/

# Lock files
package-lock.json
yarn.lock
pnpm-lock.yaml

# Claude Code's synced skills/plugins (managed by Claude Code, not part of this pack)
/synced/

# Third-party local tool (Graphify), installed outside this repo
/graphify/
# Discarded skill copies (may include proprietary vendor skills)
/.trash/

# Local draft for the next project (h3x4 Router mockup); written by another session
/h3x4-router-mockup/

# Python bytecode
__pycache__/
*.pyc
